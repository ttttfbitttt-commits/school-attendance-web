{
  "manifest_version": 3,
  "name": "حصر 2030 لرصد نور",
  "short_name": "رصد نور",
  "version": "0.1.3",
  "description": "استيراد درجات كشف نور من نظام الحصر وتعبئتها بعد مراجعة المعلم داخل صفحة نور.",
  "action": {
    "default_title": "حصر 2030 لرصد نور",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.moe.gov.sa/*", "http://*.moe.gov.sa/*"],
  "content_scripts": [
    {
      "matches": ["https://*.moe.gov.sa/*", "http://*.moe.gov.sa/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
