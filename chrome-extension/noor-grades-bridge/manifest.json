{
  "manifest_version": 3,
  "name": "حصر 2030 لرصد نور",
  "short_name": "رصد نور",
  "version": "0.1.2",
  "description": "استيراد درجات كشف نور من نظام الحصر وتعبئتها بعد مراجعة المعلم داخل صفحة نور.",
  "action": {
    "default_title": "حصر 2030 لرصد نور",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
